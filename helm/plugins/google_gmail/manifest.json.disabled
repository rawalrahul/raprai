{
  "id": "google_gmail",
  "name": "Gmail",
  "description": "Read, send, search, and manage emails via Gmail API",
  "emoji": "📧",
  "category": "productivity",
  "auth": {
    "type": "oauth2",
    "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
    "token_url": "https://oauth2.googleapis.com/token",
    "scopes": "https://www.googleapis.com/auth/gmail.modify",
    "extra_params": {"access_type": "offline", "prompt": "consent"},
    "env_client_id": "GOOGLE_CLIENT_ID",
    "env_client_secret": "GOOGLE_CLIENT_SECRET",
    "token_env": "GOOGLE_ACCESS_TOKEN",
    "refresh_token_env": "GOOGLE_REFRESH_TOKEN",
    "fallback_token": {
      "token_env": "GOOGLE_ACCESS_TOKEN",
      "token_label": "Google Access Token",
      "token_url": "https://developers.google.com/oauthplayground",
      "token_hint": "Use Google OAuth Playground → select Gmail API v1 → Authorize → Exchange for tokens → Copy access token"
    }
  },
  "env_vars": ["GOOGLE_ACCESS_TOKEN"],
  "setup_env_vars": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"],
  "keywords": ["gmail", "email", "inbox", "send email", "mail", "message"],
  "free_tier": true
}
