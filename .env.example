# Copy this file to .env and fill in the values.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs (get yours from @userinfobot)
ALLOWED_USER_IDS=

# Tuning (seconds) — defaults shown
OUTPUT_IDLE_TIMEOUT=1.5
OUTPUT_MAX_WAIT=60
OUTPUT_NO_RESPONSE=5

# Max time to wait for an AI response (seconds) — increase for long tasks like image/video generation
CLAUDE_TIMEOUT=600

# ── NemoClaw (NVIDIA sandboxed AI — FREE) ──────────────────────────────────
# Requires separate installation: WSL2 + Docker Desktop + OpenShell + NemoClaw
# Get a free API key from https://build.nvidia.com
# Follow the setup guide at your RAPR AI site
NEMOCLAW_SANDBOX=mynemo
NEMOCLAW_AUTO_START=1
NEMOCLAW_TIMEOUT=300
