# Copy this file to .env and fill in the values.

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user IDs (get yours from @userinfobot)
ALLOWED_USER_IDS=

# Tuning (seconds) — defaults shown
OUTPUT_IDLE_TIMEOUT=1.5
OUTPUT_MAX_WAIT=60
OUTPUT_NO_RESPONSE=5

# Max time to wait for an AI response (seconds) — increase for long tasks like image/video generation
CLAUDE_TIMEOUT=600

# Once a day, send the audit log's entry count and latest hash to linked chat apps
# (Telegram, WhatsApp, Discord, Slack; none needed: a copy is always kept locally)
# so lines removed or re-signed later show up in Settings -> Approvals & audit -> Verify
AUDIT_ANCHOR=1

# Ask before an AI sends, posts, comments, merges, pays or deletes something in a
# connected app (RAPR's apps and the ones connected to Claude Code): ask | allow
OUTWARD_ACTIONS=ask
# How long an AI waits for your answer before skipping the action (minutes)
OUTWARD_WAIT_MINUTES=10

# What to remember when a session ends: auto | ollama | claude | regex | off
# auto = local Ollama if running, else Claude Haiku for Claude sessions, else phrase matching
MEMORY_EXTRACTOR=auto
# MEMORY_EXTRACTOR_MODEL=qwen3:4b

# RAPR Arena: where Publish sends a bake-off result you chose to share (nothing is sent otherwise)
# ARENA_URL=https://www.raprai.com

# ── NemoClaw (NVIDIA sandboxed AI — FREE) ──────────────────────────────────
# Requires separate installation: WSL2 + Docker Desktop + OpenShell + NemoClaw
# Get a free API key from https://build.nvidia.com
# Follow the setup guide at your RAPR AI site
NEMOCLAW_SANDBOX=mynemo
NEMOCLAW_AUTO_START=1
NEMOCLAW_TIMEOUT=300

# ── Cloud backup (optional) ─────────────────────────────────────────────────
# No OAuth apps are bundled. Register your own app with each provider and set
# its credentials here (or in Settings → Cloud Backup, stored in the token vault).
BACKUP_GDRIVE_CLIENT_ID=
BACKUP_GDRIVE_CLIENT_SECRET=
BACKUP_ONEDRIVE_CLIENT_ID=
BACKUP_ONEDRIVE_CLIENT_SECRET=
BACKUP_DROPBOX_APP_KEY=
BACKUP_DROPBOX_APP_SECRET=

# Discord bot (optional): token from the Discord developer portal; allowed user IDs, comma-separated
# DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USER_IDS=
# Slack app (optional): bot token (xoxb-…), app-level token with connections:write (xapp-…)
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_ALLOWED_USER_IDS=
